@model CadastroViewModel
@{
    ViewData["Title"] = "Criar Conta";
}

<div class="card">
    <h2>Criar Conta</h2>

    <form asp-controller="Conta" asp-action="Cadastro" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" type="text" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" type="password" />
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmarSenha"></label>
            <input asp-for="ConfirmarSenha" type="password" />
            <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">Cadastrar</button>
    </form>

    <p style="margin-top:16px;">
        Já tem conta? <a asp-controller="Conta" asp-action="Login">Entrar</a>
    </p>
</div>