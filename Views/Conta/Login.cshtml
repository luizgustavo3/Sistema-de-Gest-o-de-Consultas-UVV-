@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="card">
    <h2>Entrar</h2>

    <form asp-controller="Conta" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" type="password" />
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>

        <button type="submit" class="btn">Entrar</button>
    </form>

    <p style="margin-top:16px;">
        Ainda não tem conta? <a asp-controller="Conta" asp-action="Cadastro">Criar conta</a>
    </p>
</div>