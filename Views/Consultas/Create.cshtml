@model ConsultaViewModel
@{
    ViewData["Title"] = "Nova Consulta";
}
<div class="card">
    <h2>Nova Consulta</h2>
    <form asp-controller="Consultas" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="form-group">
            <label asp-for="Especialidade"></label>
            <input asp-for="Especialidade" type="text" />
            <span asp-validation-for="Especialidade" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DataHora"></label>
            <input asp-for="DataHora" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
            <span asp-validation-for="DataHora" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" rows="4"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>
        <button type="submit" class="btn">Salvar</button>
        <a class="btn btn-secondary" asp-controller="Consultas" asp-action="Index">Cancelar</a>
    </form>
</div>
